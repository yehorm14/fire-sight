# Copy to .env.local. Base URL of the FastAPI backend (no trailing slash).
VITE_BACKEND_URL=http://localhost:8000

# Optional: external events feed. When unset, the map shows no events.
# VITE_EVENTS_API_URL=https://example.com/api/events
# Optional: show labelled sample events (demo only; overrides the feed).
# VITE_EVENTS_DEMO=true

# Optional: set both to use an authorised browser basemap. Default is the ward-boundary view.
# VITE_MAP_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=Your provider attribution
