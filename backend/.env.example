OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 to deliberately serve sample data only (reported by /api/ready as mode "mock")
FIRE_SIGHT_MOCK_MODE=
# Live explanations are off unless EXPLAIN_LIVE_ENABLED=1 (see docs/DEPLOY.md for limits)
EXPLAIN_LIVE_ENABLED=
